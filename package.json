{
  "name": "clientstrap",
  "version": "1.0.0",
  "description": "A community-made desktop launcher dashboard for Roblox on Windows.",
  "main": "main.js",
  "author": "ClientStrap contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.clientstrap.desktop",
    "productName": "ClientStrap",
    "directories": { "output": "dist" },
    "files": [
      "main.js", "preload.js", "index.html", "renderer.js",
      "styles.css", "assets/**/*", "package.json"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}